# =============================================================================
# IsoLens AI Provider Configuration
# =============================================================================
# The AI Threat Intelligence layer uses an automated 3-tier fallback router:
#   Tier 1: NVIDIA NIM API (Primary)
#   Tier 2: Google Gemini Flash (Secondary Fallback)
#   Tier 3: GitHub Copilot SDK (Final Fallback)
# =============================================================================

# -----------------------------------------------------------------------------
# Tier 1: NVIDIA NIM (https://build.nvidia.com)
# -----------------------------------------------------------------------------
# Generate your free API key at: https://build.nvidia.com
NVIDIA_API_KEY=

# Model ID on build.nvidia.com (default: meta/llama-3.3-70b-instruct)
# Other popular free models: nvidia/llama-3.1-nemotron-70b-instruct, deepseek-ai/deepseek-r1
NVIDIA_NIM_MODEL=meta/llama-3.3-70b-instruct

# Base URL for NVIDIA NIM OpenAI-compatible endpoint
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1


# -----------------------------------------------------------------------------
# Tier 2: Google Gemini (https://aistudio.google.com/)
# -----------------------------------------------------------------------------
# Generate your free Gemini API key at: https://aistudio.google.com/
GEMINI_API_KEY=

# Gemini model ID (default: gemini-2.0-flash)
# Also supported: gemini-1.5-flash
GEMINI_MODEL=gemini-2.0-flash


# -----------------------------------------------------------------------------
# Tier 3: GitHub Copilot (Local fallback)
# -----------------------------------------------------------------------------
# Optional: Only needed if not authenticated via `copilot` CLI
GITHUB_TOKEN=


# -----------------------------------------------------------------------------
# Local / LAN Model (Ollama API compatible - e.g. on Windows PC at 10.42.0.88 or localhost)
# -----------------------------------------------------------------------------
# Endpoint URL for Ollama service
LOCAL_MODEL_URL=http://10.42.0.88:11434

# Model tag hosted on Ollama (e.g. llama3.1:8b, llama3.2:3b)
LOCAL_MODEL_NAME=llama3.1:8b

# Optional: Override the fallback sequence (comma-separated)
# Options: nvidia-nim, google-gemini, copilot, local-ollama
# To prioritize local model: AI_PROVIDER_CHAIN=local-ollama,nvidia-nim,google-gemini,copilot
# Default: nvidia-nim,google-gemini,copilot,local-ollama
AI_PROVIDER_CHAIN=nvidia-nim,google-gemini,copilot,local-ollama


# =============================================================================
# System 1 GUI Screen Triage (Laya / Jev)
# =============================================================================
# Endpoint for local or LAN Laya System 1 decision server (port 8000)
LAYA_ENDPOINT=http://10.42.0.88:8000/v1/systemone
LAYA_API_KEY=
